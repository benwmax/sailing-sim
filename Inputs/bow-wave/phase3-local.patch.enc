 @TAB@bool bPlaced = false;
diff --git a/Source/SailingSim/Public/WaterSurface.h b/Source/SailingSim/Public/WaterSurface.h
index ac8001d8..71931b32 100644
--- a/Source/SailingSim/Public/WaterSurface.h
+++ b/Source/SailingSim/Public/WaterSurface.h
@@ -200,6 +200,9 @@ public:
 @TAB@ *  one line to turn it off for a release), off with -SailingClassicBowWave. Off, the curl, the bow spray and the wake
 @TAB@ *  grid's side foam are as before. */
 @TAB@static bool BowWave2On();
+@TAB@/** Bow wave 3's switch: sailing.BowWave3 (default on, GBowWave3), off with -SailingClassicWakeFold. Off, the wake grid
+@TAB@ *  makes no fold (1 in the texture's A), so M_WaterV4 draws her waves' crests as before. */
