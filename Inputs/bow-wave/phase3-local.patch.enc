 @TAB@});
diff --git a/Source/SailingSim/Public/WakeGrid.h b/Source/SailingSim/Public/WakeGrid.h
index 2db38234..e20c47e5 100644
--- a/Source/SailingSim/Public/WakeGrid.h
+++ b/Source/SailingSim/Public/WakeGrid.h
@@ -47,12 +47,21 @@ public:
 @TAB@/** The turbulent lane a hull leaves (0..1, set by her speed): her wake's smooth track, where the stirred water damps the
 @TAB@ * wind's ripples for a few lengths astern (sailing-feedback #9). */
 @TAB@const TArray<float>& Slick() const { return SlickField; }
+@TAB@/** Bow wave 3 (docs/bow-wave/): how the water bunches into her waves' crests, the Jacobian of the surface's horizontal
+@TAB@ *  displacement (Tessendorf's choppy waves on the grid's own spectrum: water moves toward each crest and away from each
+@TAB@ *  trough, as in a Gerstner wave). 1 on flat water, under 1 on a crest (sharper), over 1 in a trough; 0 or less would
+@TAB@ *  be a fold. M_WaterV4 reads it (the wake texture's A) to sharpen her waves' crests and to let them tip the chop into
+@TAB@ *  whitecaps. */
+@TAB@const TArray<float>& Fold() const { return FoldField; }
 @TAB@/** Height (m) at a map point (0 outside). */
 @TAB@float HeightAt(const FVector2D& Point) const;
@SP@
 @TAB@/** Bow wave 2 (docs/bow-wave/): foam where a hull's bow wave presses up beside her once she is fast for her length
 @TAB@ *  (AWaterSurface sets it from AWaterSurface::BowWave2On before each step). */
 @TAB@bool bBowFoam = true;
+@TAB@/** Bow wave 3 (docs/bow-wave/): make the fold (Fold); off, it stays 1 and the step skips its transform (AWaterSurface sets
+@TAB@ *  it from AWaterSurface::BowWave3On before each step). */
+@TAB@bool bFold = true;
@SP@
 private:
 @TAB@void StepOnce(float Dt, const TArray<FHull>& Hulls);
@@ -62,13 +71,14 @@ private:
 @TAB@int32 N = 0;
 @TAB@float Cell = 0.2f;
 @TAB@FVector2D Corner = FVector2D::ZeroVector;
-@TAB@TArray<float> H, Velocity, Pressure, Depth, PrevDepth, FoamField, SlickField, SlickScratch;
+@TAB@TArray<float> H, Velocity, Pressure, Depth, PrevDepth, FoamField, SlickField, SlickScratch, FoldField;
 @TAB@TArray<float> Stir, PrevStir;             // per cell, this step and the last: how hard a hull over it stirs the water (0..1, her speed)
 @TAB@TArray<float> StirMid, PrevStirMid;       // as Stir, fading to 0 toward her sides: where her bubble trail starts
 @TAB@TArray<float> NearStir;                   // per cell, this step: the fastest hull within reach of it (0..1, as Stir)
 @TAB@TArray<float> NearFroude;                 // per cell, this step: the highest length Froude number of a hull within reach
 @TAB@TArray<float> Omega;                      // per mode, rad/s (deep water)
 @TAB@TArray<std::complex<float>> Spectrum;     // scratch
+@TAB@TArray<std::complex<float>> Displacement; // scratch: the horizontal displacement, X real and Y imaginary (bow wave 3)
 @TAB@float Accumulator = 0.f;
