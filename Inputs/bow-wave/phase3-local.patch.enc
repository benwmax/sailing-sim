+@TAB@@TAB@if (UMaterialInterface* M = LoadObject<UMaterialInterface>(nullptr, TEXT("/Game/Materials/M_BowWave.M_BowWave"), nullptr, LOAD_NoWarn | LOAD_Quiet))
+@TAB@@TAB@{
+@TAB@@TAB@@TAB@BowWave->SetMaterial(0, UMaterialInstanceDynamic::Create(M, this));
+@TAB@@TAB@}
 @TAB@}
 @TAB@BowWave->SetVisibility(true);
+@TAB@// Bow wave 3 (docs/bow-wave/): M_BowWave's crest breaks white at speed (its Breaking; 0 is the sheet as before).
+@TAB@if (UMaterialInstanceDynamic* MID = Cast<UMaterialInstanceDynamic>(BowWave->GetMaterial(0)))
+@TAB@{
+@TAB@@TAB@MID->SetScalarParameterValue(TEXT("Breaking"), AWaterSurface::BowWave3On() ? 1.f : 0.f);
+@TAB@}
 @TAB@const FHullShape& Hull = Boat.GetConfig().Hulls[0];
 @TAB@const FWaveField& Waves = GM->GetWaves();
 @TAB@// Where and when she is drawn (between her steps for the player's boat, feedback #26), so the sheet stays on her stem.
