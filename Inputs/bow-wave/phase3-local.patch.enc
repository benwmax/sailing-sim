From 4548ca6dd0929320e7b11d95ab54ccf82dd4035f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 25 Nov 2026 23:57:13 +0000
Subject: [PATCH 1/2] Bow wave 3: wake crests sharpen by the water's own
 displacement

FWakeGrid makes the horizontal displacement from its step's spectrum (one
more inverse FFT, Tessendorf's choppy waves with lambda 1) and its
Jacobian, FWakeGrid::Fold. The wake texture is now half floats with the
fold in A. M_WaterV4 steepens the wake's slopes by 1 / fold and multiplies
the fold into the long waves' J, so her crests sharpen and tip the chop
into caps. Release switch sailing.BowWave3 (default 1, GBowWave3) and
-SailingClassicWakeFold: off, the fold stays 1 and the transform is
skipped. New test SailingSim.Visual.WakeFold; docs/bow-wave/ phase 3.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Aobnj4fYR5ugDMKYfb58dy
---
 Source/SailingSim/Private/WakeGrid.cpp        | 36 ++++++++
 Source/SailingSim/Private/WaterSurface.cpp    | 39 ++++++++-
 Source/SailingSim/Public/WakeGrid.h           | 12 ++-
 Source/SailingSim/Public/WaterSurface.h       |  3 +
 Source/SailingSimTests/Private/WaterTests.cpp | 82 +++++++++++++++++++
 docs/bow-wave/README.md                       | 42 ++++++++--
 scripts/make_materials.py                     | 12 ++-
 7 files changed, 213 insertions(+), 13 deletions(-)

diff --git a/Source/SailingSim/Private/WakeGrid.cpp b/Source/SailingSim/Private/WakeGrid.cpp
index 84f48312..8a791da9 100644
--- a/Source/SailingSim/Private/WakeGrid.cpp
+++ b/Source/SailingSim/Private/WakeGrid.cpp
@@ -11,6 +11,10 @@ namespace
 @TAB@// every step, a flat white sheet wider than her beam (docs/frigate-import/).
 @TAB@constexpr float kMaxDepth = 2.3f;
 @TAB@constexpr int32 kSponge = 8;       // cells of absorbing border
+@TAB@// Bow wave 3 (docs/bow-wave/): how far the water moves toward a crest, as a share of the linear wave's own orbit (1: a
+@TAB@// Gerstner wave's; Tessendorf's lambda). Her waves are a few centimetres high, so it moves a few centimetres and the
+@TAB@// Jacobian stays above 0.6 in flat water (0.84 at the J/22's bow at 6 kn, 0.68 in her wake): no folds of her own.
+@TAB@constexpr float kChop = 1.f;
@SP@
 @TAB@/** In-place radix-2 complex FFT of one line (Sign +1 inverse sense, -1 forward; unnormalized). */
 @TAB@void Fft(std::complex<float>* A, int32 Count, int32 Stride, float Sign)
@@ -54,7 +58,9 @@ void FWakeGrid::Init(int32 InN, float InCell)
 @TAB@Cell = InCell;
 @TAB@const int32 NN = N * N;
 @TAB@for (TArray<float>* A : { &H, &Velocity, &Pressure, &Depth, &PrevDepth, &FoamField, &SlickField, &SlickScratch, &Stir, &PrevStir, &NearStir, &NearFroude, &StirMid, &PrevStirMid }) A->Init(0.f, NN);
+@TAB@FoldField.Init(1.f, NN);
 @TAB@Spectrum.SetNumZeroed(NN);
+@TAB@Displacement.SetNumZeroed(NN);
 @TAB@Omega.SetNumUninitialized(NN);
 @TAB@const float Dk = 2.f * UE_PI / (N * Cell);
 @TAB@for (int32 R = 0; R < N; ++R)
@@ -215,6 +221,7 @@ void FWakeGrid::StepOnce(float Dt, const TArray<FHull>& Hulls)
 @TAB@ParallelFor(N, [&](int32 R)
 @TAB@{
 @TAB@@TAB@const int32 Rm = (N - R) % N;
+@TAB@@TAB@const int32 Kr = R < N / 2 ? R : R - N;    // the mode's wavenumber along X, in grid units
 @TAB@@TAB@for (int32 C = 0; C < N; ++C)
 @TAB@@TAB@{
 @TAB@@TAB@@TAB@const int32 I = R * N + C, Im = Rm * N + (N - C) % N;
@@ -236,9 +243,38 @@ void FWakeGrid::StepOnce(float Dt, const TArray<FHull>& Hulls)
 @TAB@@TAB@@TAB@@TAB@V1 = Decay * (V * Cs - (W * W * Q + 0.5f * kAlpha * V) * (Sn / Wd));
 @TAB@@TAB@@TAB@}
 @TAB@@TAB@@TAB@Out[I] = (Q1 + std::complex<float>(0.f, 1.f) * V1) * Norm;
+@TAB@@TAB@@TAB@// Bow wave 3: the horizontal displacement, i k/|k| q per mode (with this transform's signs, for h = A cos kx it is
+@TAB@@TAB@@TAB@// -A sin kx: toward the crest), X and Y packed as one field's real and imaginary parts, (i kx - ky) / |k| q. None
+@TAB@@TAB@@TAB@// for the mean or the Nyquist rows and columns (no direction to give them).
+@TAB@@TAB@@TAB@if (!bFold) continue;
+@TAB@@TAB@@TAB@const int32 Kc = C < N / 2 ? C : C - N;
+@TAB@@TAB@@TAB@if (W < 1e-4f || R == N / 2 || C == N / 2) Displacement[I] = 0.f;
+@TAB@@TAB@@TAB@else
+@TAB@@TAB@@TAB@{
+@TAB@@TAB@@TAB@@TAB@const float Kn = FMath::Sqrt(float(Kr * Kr + Kc * Kc));
+@TAB@@TAB@@TAB@@TAB@Displacement[I] = Q1 * std::complex<float>(-float(Kc) / Kn, float(Kr) / Kn) * Norm;
+@TAB@@TAB@@TAB@}
 @TAB@@TAB@}
 @TAB@});
 @TAB@Fft2(Out, N, 1.f);
+@TAB@// Bow wave 3: its Jacobian, by central differences (one-sided at the edges). Off: flat (1).
+@TAB@if (!bFold) FoldField.Init(1.f, N * N);
+@TAB@else
+@TAB@{
+@TAB@@TAB@Fft2(Displacement, N, 1.f);
+@TAB@@TAB@ParallelFor(N, [&](int32 R)
+@TAB@@TAB@{
+@TAB@@TAB@@TAB@const int32 Ru = FMath::Max(R - 1, 0), Rd = FMath::Min(R + 1, N - 1);
+@TAB@@TAB@@TAB@for (int32 C = 0; C < N; ++C)
+@TAB@@TAB@@TAB@{
+@TAB@@TAB@@TAB@@TAB@const int32 Cl = FMath::Max(C - 1, 0), Cr = FMath::Min(C + 1, N - 1);
+@TAB@@TAB@@TAB@@TAB@const float Sx = kChop / (float(Rd - Ru) * Cell), Sy = kChop / (float(Cr - Cl) * Cell);
+@TAB@@TAB@@TAB@@TAB@const std::complex<float> Dn = Displacement[Rd * N + C] - Displacement[Ru * N + C];
+@TAB@@TAB@@TAB@@TAB@const std::complex<float> De = Displacement[R * N + Cr] - Displacement[R * N + Cl];
+@TAB@@TAB@@TAB@@TAB@FoldField[R * N + C] = (1.f + Dn.real() * Sx) * (1.f + De.imag() * Sy) - (De.real() * Sy) * (Dn.imag() * Sx);
+@TAB@@TAB@@TAB@}
+@TAB@@TAB@});
+@TAB@}
@SP@
 @TAB@ParallelFor(N, [&](int32 R)
 @TAB@{
