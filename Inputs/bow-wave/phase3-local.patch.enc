diff --git a/Source/SailingSimTests/Private/WaterTests.cpp b/Source/SailingSimTests/Private/WaterTests.cpp
index 5a57935d..b95f8322 100644
--- a/Source/SailingSimTests/Private/WaterTests.cpp
+++ b/Source/SailingSimTests/Private/WaterTests.cpp
@@ -218,6 +218,88 @@ bool FWaterBowCrestTest::RunTest(const FString&)
 @TAB@return true;
 }
@SP@
+/**
+ * Bow wave 3 (docs/bow-wave/): her waves' crests are sharpened the way a Gerstner wave's are, by moving the water toward
+ * each crest (FWakeGrid::Fold, the Jacobian of that displacement). On a crest it is under 1, in a trough over 1, and it
+ * averages 1. In flat water her own waves never fold (it stays well above 0): only with the chop on top can they tip into
+ * a whitecap (M_WaterV4). The numbers from the offline replica (docs/bow-wave/README.md): 0.84 at her bow at 6 kn, on
+ * the crest beside her, and 0.68 at the lowest in her wake.
+ */
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FWaterWakeFoldTest, "SailingSim.Visual.WakeFold", WaterFlags)
+bool FWaterWakeFoldTest::RunTest(const FString&)
+{
+@TAB@const FBoatConfig Config;
+@TAB@const FBoatModel Model(Config);
+@TAB@const FHullShape& Shape = Config.Hulls[0];
+@TAB@const double Canoe = Model.HullDepth();
+@TAB@auto Wet = [&](double X, double Y)
+@TAB@{
+@TAB@@TAB@if (X < Shape.SternX || X > Shape.BowX || FMath::Abs(Y) > Shape.DeckHalfBeam(X)) return 0.0;
+@TAB@@TAB@return FMath::Max(0.0, -Shape.BottomZ(X, Y, Canoe));
+@TAB@};
+@TAB@struct FFolds { float BowMin = 9.f, BowMinHeight = 0.f, OpenMin = 9.f, CrestMean = 0.f, TroughMean = 0.f, Mean = 0.f; };
+@TAB@auto SailAt = [&](float Speed)
+@TAB@{
+@TAB@@TAB@FWakeGrid Grid;
+@TAB@@TAB@Grid.Init(256, 0.25f);
+@TAB@@TAB@FWakeGrid::FHull Hull;
+@TAB@@TAB@Hull.Shape = &Shape;
+@TAB@@TAB@Hull.CanoeDepth = float(Canoe);
+@TAB@@TAB@Hull.Speed = Speed;
+@TAB@@TAB@Hull.Position = FVector2D(0.0, 0.0);
+@TAB@@TAB@TArray<FWakeGrid::FHull> Hulls = { Hull };
+@TAB@@TAB@const float Dt = 1.f / 60.f;
+@TAB@@TAB@for (int32 I = 0; I < 12 * 60; ++I)
+@TAB@@TAB@{
+@TAB@@TAB@@TAB@Hulls[0].Position.X += Speed * Dt;
+@TAB@@TAB@@TAB@Grid.Follow(Hulls[0].Position);
+@TAB@@TAB@@TAB@Grid.Step(Dt, Hulls);
+@TAB@@TAB@}
+@TAB@@TAB@const int32 N = Grid.Size();
+@TAB@@TAB@const double Cell = Grid.CellSize();
+@TAB@@TAB@const TArray<float>& H = Grid.Heights();
+@TAB@@TAB@const TArray<float>& J = Grid.Fold();
+@TAB@@TAB@FFolds Out;
+@TAB@@TAB@double Crest = 0.0, Trough = 0.0, All = 0.0;
+@TAB@@TAB@int32 NCrest = 0, NTrough = 0, NAll = 0;
+@TAB@@TAB@for (int32 R = 8; R < N - 8; ++R)
+@TAB@@TAB@{
+@TAB@@TAB@@TAB@for (int32 C = 8; C < N - 8; ++C)
+@TAB@@TAB@@TAB@{
+@TAB@@TAB@@TAB@@TAB@const FVector2D P = Grid.Origin() + FVector2D((R + 0.5) * Cell, (C + 0.5) * Cell) - Hulls[0].Position;
+@TAB@@TAB@@TAB@@TAB@if (Wet(P.X, P.Y) >= 0.005) continue;
+@TAB@@TAB@@TAB@@TAB@const int32 I = R * N + C;
+@TAB@@TAB@@TAB@@TAB@const double Beside = FMath::Max(FMath::Max(Wet(P.X - Cell, P.Y), Wet(P.X + Cell, P.Y)), FMath::Max(Wet(P.X, P.Y - Cell), Wet(P.X, P.Y + Cell)));
+@TAB@@TAB@@TAB@@TAB@// Her bow: the open water from just ahead of the stem to 3.5 m aft, within 3 m of her centreline.
+@TAB@@TAB@@TAB@@TAB@if (P.X > Shape.BowX - 3.5 && P.X < Shape.BowX + 0.25 && FMath::Abs(P.Y) < 3.0 && J[I] < Out.BowMin)
+@TAB@@TAB@@TAB@@TAB@{
+@TAB@@TAB@@TAB@@TAB@@TAB@Out.BowMin = J[I];
+@TAB@@TAB@@TAB@@TAB@@TAB@Out.BowMinHeight = H[I];
+@TAB@@TAB@@TAB@@TAB@}
+@TAB@@TAB@@TAB@@TAB@if (Beside >= 0.005) continue;
+@TAB@@TAB@@TAB@@TAB@Out.OpenMin = FMath::Min(Out.OpenMin, J[I]);
+@TAB@@TAB@@TAB@@TAB@All += J[I]; ++NAll;
+@TAB@@TAB@@TAB@@TAB@if (H[I] > 0.01f) { Crest += J[I]; ++NCrest; }
+@TAB@@TAB@@TAB@@TAB@if (H[I] < -0.01f) { Trough += J[I]; ++NTrough; }
+@TAB@@TAB@@TAB@}
+@TAB@@TAB@}
+@TAB@@TAB@Out.CrestMean = NCrest > 0 ? float(Crest / NCrest) : 1.f;
+@TAB@@TAB@Out.TroughMean = NTrough > 0 ? float(Trough / NTrough) : 1.f;
+@TAB@@TAB@Out.Mean = NAll > 0 ? float(All / NAll) : 0.f;
+@TAB@@TAB@AddInfo(FString::Printf(TEXT("%.1f kn: fold at her bow %.3f (on water %.3f m high), lowest in open water %.3f, crests %.3f (%d cells), troughs %.3f (%d), mean %.4f"),
+@TAB@@TAB@@TAB@Speed / 0.5144f, Out.BowMin, Out.BowMinHeight, Out.OpenMin, Out.CrestMean, NCrest, Out.TroughMean, NTrough, Out.Mean));
+@TAB@@TAB@return Out;
+@TAB@};
+@TAB@const FFolds Slow = SailAt(1.54f), Fast = SailAt(3.09f);
+@TAB@TestTrue(TEXT("At 6 kn the crest beside her bow is bunched"), Fast.BowMin > 0.7f && Fast.BowMin < 0.95f);
+@TAB@TestTrue(TEXT("The bunching is on the crest"), Fast.BowMinHeight > 0.01f);
+@TAB@TestTrue(TEXT("At 3 kn it is gentler"), Slow.BowMin > Fast.BowMin);
+@TAB@TestTrue(TEXT("Crests bunch and troughs spread"), Fast.CrestMean < 0.99f && Fast.TroughMean > 1.01f);
+@TAB@TestTrue(TEXT("The water is moved, not made: the fold averages 1"), FMath::Abs(Fast.Mean - 1.f) < 0.01f);
+@TAB@TestTrue(TEXT("Her own waves never fold in flat water"), Fast.OpenMin > 0.5f && Slow.OpenMin > 0.5f);
+@TAB@return true;
+}
+
 namespace
 {
 @TAB@/**
diff --git a/docs/bow-wave/README.md b/docs/bow-wave/README.md
index 5d236d50..3f7d2c2b 100644
--- a/docs/bow-wave/README.md
+++ b/docs/bow-wave/README.md
@@ -2,7 +2,7 @@
@SP@
 Bean asked for a bow wave that splits more realistically and in more detail. The research and the full plan are in the
 Claude Doc "Bow wave and wake: research and plan". Phases 1 to 3 go into the Dec 11 release (Bean's choice, Nov 25);
-phases 4 to 6 come after it. This page covers phases 1 and 2.
+phases 4 to 6 come after it. This page covers phases 1 to 3.
@SP@
 ## What was wrong (phase 1 findings)
@SP@
@@ -96,8 +96,38 @@ show the lee bow from a chase boat. They have not been screened for the bow yet.
 - how wide the white band is, and how long it lasts astern
 - where the spray leaves the bow, and how high it goes
@SP@
-## Next: phase 3
-
-Sharper crests: horizontal displacement from the wake grid (one more complex FFT a step), foam where the surface folds,
-and a 16-bit wake texture. This needs `make_materials.py`, so the pull request needs Bean's `bean-approved` label, and
-it waits for the lake wind streaks PR (#837), which changes the same material.
+## Phase 3: sharper crests
+
+In a real wake the crests are sharp and the troughs round, because the water moves toward each crest as it rises. A
+linear height field draws them as sine waves. Tessendorf's choppy waves fix that from the same spectrum: each mode's
+water moves by i k/|k| times its height (for h = A cos kx, -A sin kx, toward the crest, as in a Gerstner wave).
+
+- **The solver:** `FWakeGrid` makes the displacement from the step's own spectrum (one more inverse FFT a step, both
+  directions packed as one complex field) and its Jacobian, `FWakeGrid::Fold`: 1 on flat water, under 1 on a crest,
+  over 1 in a trough. It takes the spectrum of height plus hull pressure, which is nearly flat under her, so the hull's
+  hollow doesn't push the water around her sides. `kChop` is 1 (a Gerstner wave's own orbit).
+- **The texture:** the wake texture's unused A channel carries the fold, and the texture is now half floats: half the
+  upload at 30 Hz (2 MB a frame on Ultra instead of 4), with heights still to a fraction of a millimetre.
+- **The water material:** `M_WaterV4` steepens the wake's slopes by 1 / fold, so crests catch the light as narrow
+  bright lines and troughs go smooth. The fold also multiplies the long waves' (J), so where her crests cross the
+  chop's they tip it into whitecaps sooner, and the foam gathers on her crests as it does on the waves'.
+
+Offline, at 6 kn: the water moves up to 9 cm, the fold is 0.84 on the crest beside her bow (about 2.9 m aft of the
+stem, where the crest is 2.7 cm high) and 0.68 at the lowest in her wake. It averages 1, and is 0.96 on crests and 1.04
+in troughs. At 3 kn the lowest is 0.83 and the bow's 0.96. In flat water her waves never fold (that would take 0 or
+less), so phase 2's pressed-crest foam stays the only foam at her bow there. In a breeze her crests now add to the
+chop's caps.
+
+The vertices don't move: the water's finest vertex spacing is 0.5 m, twice the grid's cell, so moving them by a few
+centimetres wouldn't show. The sharpening is in the shading, and phase 4's dense patch near the boat is where the
+geometry gets it.
+
+**Switch and compare:** the console's `sailing.BowWave3` (default 1; `GBowWave3` in `WaterSurface.cpp`, one line for
+the release) and `-SailingClassicWakeFold` for one run. Off, the grid makes no fold (1 in the texture's A, and the step
+skips its transform), so the material draws her crests as before; the half-float texture stays.
+
+**Test:** `SailingSim.Visual.WakeFold` checks the fold at her bow at 6 kn (0.7 to 0.95, on the crest), that it is gentler
+at 3 kn, that crests bunch and troughs spread, that it averages 1, and that her waves never fold in flat water.
+
+Phase 3 changes `make_materials.py`, so its pull request needs Bean's `bean-approved` label. It goes in after the lake
+wind streaks PR (#837), which changes the same material.
diff --git a/scripts/make_materials.py b/scripts/make_materials.py
index 71910b90..49d9f193 100644
--- a/scripts/make_materials.py
+++ b/scripts/make_materials.py
@@ -3645,12 +3645,20 @@ float wakeSlick = 0.0;
 {
     float e = 1.0 / WakeGridRect.w;
     float2 uv = float2(wg.y, wg.x);
-    float3 c = WakeGrid.SampleLevel(WakeGridSampler, uv, 0).rgb;
+    float4 c = WakeGrid.SampleLevel(WakeGridSampler, uv, 0);
     wakeSlick = c.b;
     float hx = WakeGrid.SampleLevel(WakeGridSampler, uv + float2(0.0, e), 0).r - WakeGrid.SampleLevel(WakeGridSampler, uv - float2(0.0, e), 0).r;
     float hy = WakeGrid.SampleLevel(WakeGridSampler, uv + float2(e, 0.0), 0).r - WakeGrid.SampleLevel(WakeGridSampler, uv - float2(e, 0.0), 0).r;
     float cell = WakeGridRect.z / WakeGridRect.w;
-    sx += hx / (2.0 * cell); sy += hy / (2.0 * cell);
+    // Bow wave 3 (docs/bow-wave/): her waves' water moves toward their crests (FWakeGrid::Fold, A: the Jacobian of that
+    // displacement, under 1 on a crest), so a crest is steeper than the height alone says, by 1 / fold along it, and a
+    // trough flatter: sharp crests and rounded troughs, as a real wake has. The fold also joins the long waves' (J), so
+    // where her crests cross the chop's they tip it into whitecaps sooner (Jt, the cap table's threshold, the foam's
+    // gathering); in flat water her own never fold (0.68 at the lowest at 6 kn).
+    float wakeFold = clamp(c.a, 0.05, 2.0);
+    float wakeSharp = 1.0 / max(wakeFold, 0.5);
+    sx += hx / (2.0 * cell) * wakeSharp; sy += hy / (2.0 * cell) * wakeSharp;
+    J *= wakeFold;
     wakeFoam = c.g;
 }
 float om = 0.0;
--@SP@
2.43.0


From e97d6c000154c241026c20aea5f747a3378cfccf Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 26 Nov 2026 03:42:34 +0000
Subject: [PATCH 2/2] Bow wave 3: the bow's crest breaks white at speed

The PC's bow-facing stills of bow wave 2 (Nov 26) showed the curl's lip a few centimetres wide, more gap than foam:
the crest's rise falls off quickly aft of the stem, so its foam seldom passed half. M_BowWave takes Breaking (the
pawn's material instance sets it while sailing.BowWave3 is on): from about 5 kn, full by 7, the crest holds its white
further aft, widens, closes most of its gaps and is torn into streaks drifting aft, and the face outboard of it
carries streaks too. Breaking 0 is the old sheet exactly. The one-run switch is now -SailingClassicBowWave3 (it covers
the fold and the curl).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Aobnj4fYR5ugDMKYfb58dy
---
 .../SailingSim/Private/BoatModelVisuals.cpp   | 10 +++++-
 Source/SailingSim/Private/WaterSurface.cpp    |  6 ++--
 Source/SailingSim/Public/WaterSurface.h       |  5 +--
 docs/bow-wave/README.md                       | 15 +++++++--
 scripts/make_materials.py                     | 32 ++++++++++++++++---
 5 files changed, 56 insertions(+), 12 deletions(-)

