+{
+@TAB@static SailingArgs::FCachedFlag ClassicWakeFoldArg(TEXT("SailingClassicWakeFold"));
+@TAB@return GBowWave3 != 0 && !ClassicWakeFoldArg.Get();
+}
+
 bool AWaterSurface::BowWave2On()
 {
 @TAB@static SailingArgs::FCachedFlag ClassicBowWaveArg(TEXT("SailingClassicBowWave"));
@@ -424,7 +452,8 @@ void AWaterSurface::CreateWaterMaterial()
 @TAB@@TAB@{
 @TAB@@TAB@@TAB@WaitForWorkers();
 @TAB@@TAB@@TAB@Wake.Init(WakeN, Tier >= 2 ? 0.25f : 0.3f);
-@TAB@@TAB@@TAB@WakeGridMap = MakeFloatMap(WakeN, WakeN, PF_A32B32G32R32F, false);
+@TAB@@TAB@@TAB@// Bow wave 3: half floats (heights to a fraction of a millimetre, the fold to 1/2000): half the upload at 30 Hz.
+@TAB@@TAB@@TAB@WakeGridMap = MakeFloatMap(WakeN, WakeN, PF_FloatRGBA, false);
 @TAB@@TAB@}
 @TAB@@TAB@WaterMaterial->SetTextureParameterValue(TEXT("DetailA"), DetailAMap);
 @TAB@@TAB@WaterMaterial->SetTextureParameterValue(TEXT("DetailB"), DetailBMap);
@@ -1391,7 +1420,7 @@ void AWaterSurface::UpdateWakeGrid(float DeltaSeconds)
 @TAB@@TAB@if (!PendingWake.IsReady()) return;
 @TAB@@TAB@FWakeFrame Done = PendingWake.Consume();
 @TAB@@TAB@bWakePending = false;
-@TAB@@TAB@UploadFloats(WakeGridMap, Done.Pixels, Done.N, Done.N, 4);
+@TAB@@TAB@UploadHalfs(WakeGridMap, Done.Pixels, Done.N, Done.N, 4);
 @TAB@@TAB@// W4: keep its foam channel for the foam grid.
 @TAB@@TAB@WakeFoamN = Done.N;
 @TAB@@TAB@WakeFoamOrigin = Done.Origin;
@@ -1458,6 +1487,7 @@ void AWaterSurface::UpdateWakeGrid(float DeltaSeconds)
@SP@
 @TAB@FWakeGrid* Grid = &Wake;
 @TAB@Grid->bBowFoam = BowWave2On();
+@TAB@Grid->bFold = BowWave3On();
 @TAB@const FVector2D Centre = BoatPos;
 @TAB@const float Dt = WakeDtPending;
 @TAB@WakeDtPending = 0.f;
@@ -1472,14 +1502,15 @@ void AWaterSurface::UpdateWakeGrid(float DeltaSeconds)
 @TAB@@TAB@const TArray<float>& H = Grid->Heights();
 @TAB@@TAB@const TArray<float>& F = Grid->Foam();
 @TAB@@TAB@const TArray<float>& Sl = Grid->Slick();
-@TAB@@TAB@// RGBA: height, foam, the wake's smooth lane (docs/wake-slick/), unused.
+@TAB@@TAB@const TArray<float>& Fo = Grid->Fold();
+@TAB@@TAB@// RGBA: height, foam, the wake's smooth lane (docs/wake-slick/), the fold (bow wave 3: how her waves bunch into crests).
 @TAB@@TAB@Out.Pixels.SetNumUninitialized(Out.N * Out.N * 4);
 @TAB@@TAB@for (int32 I = 0; I < Out.N * Out.N; ++I)
 @TAB@@TAB@{
 @TAB@@TAB@@TAB@Out.Pixels[4 * I] = H[I];
 @TAB@@TAB@@TAB@Out.Pixels[4 * I + 1] = F[I];
 @TAB@@TAB@@TAB@Out.Pixels[4 * I + 2] = Sl[I];
-@TAB@@TAB@@TAB@Out.Pixels[4 * I + 3] = 0.f;
