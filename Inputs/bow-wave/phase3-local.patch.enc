@SP@
+@TAB@/** As UploadFloats, packed to half floats on the way (the texture is PF_FloatRGBA or PF_R16F by its channels). */
+@TAB@void UploadHalfs(UTexture2D* Tex, const TArray<float>& Values, int32 Width, int32 Height, int32 Channels)
+@TAB@{
+@TAB@@TAB@uint8* Copy = new uint8[Values.Num() * sizeof(FFloat16)];
+@TAB@@TAB@FFloat16* Halfs = reinterpret_cast<FFloat16*>(Copy);
+@TAB@@TAB@for (int32 I = 0; I < Values.Num(); ++I) Halfs[I] = FFloat16(Values[I]);
+@TAB@@TAB@FUpdateTextureRegion2D* Region = new FUpdateTextureRegion2D(0, 0, 0, 0, Width, Height);
+@TAB@@TAB@Tex->UpdateTextureRegions(0, 1, Region, Width * Channels * sizeof(FFloat16), Channels * sizeof(FFloat16), Copy, [](uint8* Data, const FUpdateTextureRegion2D* R)
+@TAB@@TAB@{
+@TAB@@TAB@@TAB@delete[] Data;
+@TAB@@TAB@@TAB@delete R;
+@TAB@@TAB@});
+@TAB@}
+
 @TAB@/** A wrapping RGBA half-float texture with a full mip chain: the pixel shader filters it (trilinear), so distant
 @TAB@ *  short waves average out instead of sparkling. Half floats halve what the anisotropic
 @TAB@ *  taps fetch; centimetre heights and slopes keep three significant digits. */
@@ -249,6 +263,20 @@ namespace
 @TAB@@TAB@TEXT("Bow wave 2 (1 on, 0 off): the bow's curl on the water as drawn, its spray from the curl's lip, foam where her bow wave presses on her side."));
 }
@SP@
+namespace
+{
+@TAB@// Bow wave 3 (docs/bow-wave/): the release switch. 0 here ships her waves' crests as they were before it.
+@TAB@int32 GBowWave3 = 1;
+@TAB@FAutoConsoleVariableRef CVarBowWave3(TEXT("sailing.BowWave3"), GBowWave3,
+@TAB@@TAB@TEXT("Bow wave 3 (1 on, 0 off): her waves' crests sharpened by the water moving toward them, and tipping the chop into caps."));
+}
+
