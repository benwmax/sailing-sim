+	// stutter-main/scopes (local measuring): -SailingWakeFftCap=<k> runs each FFT pass as k chunks (k tasks at most)
+	// instead of one task per row; 0 (default) is unchanged.
+	int32 WakeFftCap()
+	{
+		static int32 Cap = -1;
+		static uint32 Gen = MAX_uint32;
+		if (Gen != SailingArgs::Generation()) { Gen = SailingArgs::Generation(); Cap = 0; FParse::Value(SailingArgs::Dev(), TEXT("SailingWakeFftCap="), Cap); }
+		return Cap;
+	}
+
+	template <typename F> void WakeFor(int32 Num, F&& Body)
+	{
+		const int32 Cap = WakeFftCap();
+		if (Cap <= 0 || Cap >= Num) { ParallelFor(Num, Body); return; }
+		ParallelFor(Cap, [&](int32 B) { for (int32 I = B * Num / Cap; I < (B + 1) * Num / Cap; ++I) Body(I); });
+	}
+
 	void Fft2(TArray<std::complex<float>>& A, int32 N, float Sign)
