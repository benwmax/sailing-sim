+		WakeFor(N, [&](int32 R) { TRACE_CPUPROFILER_EVENT_SCOPE(Sailing_PF_WakeFftRows); Fft(A.GetData() + R * N, N, 1, Sign); });
+		WakeFor(N, [&](int32 C) { TRACE_CPUPROFILER_EVENT_SCOPE(Sailing_PF_WakeFftCols); Fft(A.GetData() + C, N, N, Sign); });
