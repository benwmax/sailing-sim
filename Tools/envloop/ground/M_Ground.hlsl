const float DARK[8] = {0.2500, 0.2500, 0.4500, 0.3500, 0.4000, 0.0000, 0.4000, 0.3000};
const float RWET[8] = {0.5500, 0.6000, 0.3500, 0.5500, 0.3500, 0.2500, 0.4000, 0.5000};
