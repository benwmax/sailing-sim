// Surfaces: 0 lawn, 1 rough, 2 clay, 3 gravel, 4 sand, 5 mud, 6 cracked, 7 litter
const float3 ALB_S[8] = {float3(0.1100, 0.1400, 0.0580), float3(0.1500, 0.1550, 0.0750), float3(0.1500, 0.1250, 0.0950), float3(0.2650, 0.2500, 0.2150), float3(0.3000, 0.2500, 0.1750), float3(0.0850, 0.0720, 0.0520), float3(0.1750, 0.1550, 0.1200), float3(0.1100, 0.0950, 0.0550)};
