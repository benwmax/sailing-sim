const float2 BAND_A = float2(35.0, 45.0);
const float2 BAND_B = float2(75.0, 85.0);

struct GroundFn
{
    float Hash(float2 i) { return frac(abs(sin(i.x * 127.1 + i.y * 311.7) * 43758.5453)); }
    float VNoise(float2 q)
    {
