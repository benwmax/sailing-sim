    "check": {"tier": "High", "width": 640, "height": 360, "spatial": 1, "temporal": 1, "render_warmup": 0, "format": "png"},
    "preview": {"tier": "High", "width": 1280, "height": 720, "spatial": 1, "temporal": 2, "render_warmup": 16, "format": "png"},
    "master": {"tier": "Ultra", "width": 3840, "height": 2160, "spatial": 4, "temporal": 4, "render_warmup": 32, "format": "png"}
  },
  "shots": {
