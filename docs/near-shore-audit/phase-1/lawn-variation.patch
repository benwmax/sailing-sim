--- a/scripts/make_materials.py
+++ b/scripts/make_materials.py
@@ -968,6 +968,19 @@ if (Land > 0.5)
 // The wet band: banks are dark and glossy from the water up the swash, about half a metre (ragged); just under the
 // surface the bed takes the water's olive cast.
 float h = (P.z - WaterZ) * 0.01;
+// pc/shore-residential (docs/near-shore-audit, gap 3): a mown lawn isn't one flat green. On the grass (green over red in
+// the vertex colour, a metre and more above the water): mowing stripes 2.5 m wide, each 40 m block mown its own way,
+// and drier, yellower patches a few metres across where the sprinklers don't reach.
+{
+    float grassK = saturate((C.g - C.r) * 30.0) * smoothstep(0.8, 1.4, h) * (1.0 - Land);
+    float2 blk = floor(p.xy / 40.0);
+    float ang = 6.2831853 * frac(sin(dot(blk, float2(41.3, 97.1))) * 43758.5);
+    float stripe = step(0.5, frac(dot(p.xy, float2(cos(ang), sin(ang))) / 5.0));
+    float dry = smoothstep(0.35, 0.85, 0.5 + 0.5 * sin(p.x * 0.31 + sin(p.y * 0.23) * 2.3) * sin(p.y * 0.37 + sin(p.x * 0.19) * 1.9) + 0.15 * f);
+    float3 lawn = col * (0.94 + 0.12 * stripe);
+    lawn = lerp(lawn, lawn * float3(1.25, 1.12, 0.7), dry * 0.55);
+    col = lerp(col, lawn, grassK);
+}
 // (Realism audit 10: the margin read as pale dry clay to the water. Now wetter and a little higher, and the first few
 // centimetres over the water carry a green-brown film of algae and silt, the line a reservoir's edge always has.)
 float wet = (1.0 - smoothstep(0.05, 0.6 + 0.2 * n + 0.08 * f, h)) * CA;    // CA: open water within 14 m (Graphics G6)
